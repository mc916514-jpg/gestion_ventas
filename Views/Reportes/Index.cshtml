@model DashboardViewModel
@{
    ViewData["Title"] = "Panel de Control Administrativo";
}

<h2 class="font-outfit fw-bold mb-4 text-white"><i class="fa-solid fa-chart-pie text-indigo-soft me-2"></i> Dashboard Administrativo</h2>

<!-- FILA DE METRICAS PRINCIPALES (KPIs) -->
<div class="row g-4 mb-5">
    
    <!-- TOTAL VENTAS -->
    <div class="col-md-6 col-lg-3">
        <div class="glass-card card-glow h-100">
            <div class="stat-icon bg-indigo-soft">
                <i class="fa-solid fa-wallet"></i>
            </div>
            <div class="stat-val">$@Model.TotalVentas.ToString("N2")</div>
            <div class="stat-title">Ventas Totales</div>
        </div>
    </div>

    <!-- PEDIDOS COMPLETADOS -->
    <div class="col-md-6 col-lg-3">
        <div class="glass-card card-glow h-100">
            <div class="stat-icon bg-emerald-soft">
                <i class="fa-solid fa-circle-check"></i>
            </div>
            <div class="stat-val">@Model.PedidosCompletados</div>
            <div class="stat-title">Pedidos Completados</div>
        </div>
    </div>

    <!-- ALERTAS STOCK -->
    <div class="col-md-6 col-lg-3">
        <a asp-controller="Inventario" asp-action="Index" class="text-decoration-none h-100 d-block">
            <div class="glass-card card-glow h-100">
                <div class="stat-icon bg-amber-soft">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </div>
                <div class="stat-val text-warning">@Model.AlertasStock</div>
                <div class="stat-title">Alertas de Stock Crítico</div>
            </div>
        </a>
    </div>

    <!-- USUARIOS REGISTRADOS -->
    <div class="col-md-6 col-lg-3">
        <div class="glass-card card-glow h-100">
            <div class="stat-icon bg-rose-soft">
                <i class="fa-solid fa-users"></i>
            </div>
            <div class="stat-val">@Model.UsuariosRegistrados</div>
            <div class="stat-title">Usuarios Registrados</div>
        </div>
    </div>

</div>

<!-- FILA DE GRÁFICOS INTERACTIVOS (AJAX + CHART.JS) -->
<div class="row g-4 mb-5">
    
    <!-- Gráfico Diario de Ventas -->
    <div class="col-lg-8">
        <div class="glass-card card-glow">
            <h5 class="font-outfit fw-bold text-white mb-4"><i class="fa-solid fa-chart-line text-indigo-soft me-2"></i> Evolución de Ventas (Últimos 7 Días)</h5>
            <div style="position: relative; height: 320px;">
                <canvas id="salesChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Gráfico de Ventas por Categoría -->
    <div class="col-lg-4">
        <div class="glass-card card-glow">
            <h5 class="font-outfit fw-bold text-white mb-4"><i class="fa-solid fa-chart-pie text-indigo-soft me-2"></i> Ventas por Categoría</h5>
            <div style="position: relative; height: 320px;">
                <canvas id="categoryChart"></canvas>
            </div>
        </div>
    </div>

</div>

<!-- HISTORIAL DE AUDITORÍA Y TRAZA DE SEGURIDAD -->
<div class="glass-card mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3" style="border-color: var(--card-border-dark) !important;">
        <h4 class="font-outfit fw-bold mb-0 text-white"><i class="fa-solid fa-user-shield text-indigo-soft me-2"></i> Bitácora de Seguridad (Audit Trail)</h4>
        <span class="badge bg-indigo-soft py-2 px-3 fw-bold small">Últimas 15 Acciones</span>
    </div>

    <div class="table-responsive-custom">
        <table class="custom-table table-sm">
            <thead>
                <tr>
                    <th>Código ID</th>
                    <th>Acción</th>
                    <th>Detalle de Operación</th>
                    <th>Dirección IP</th>
                    <th class="text-end">Fecha / Hora</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model.AuditLogs)
                {
                    var actionColor = log.Accion.Contains("Crear") || log.Accion.Contains("Insert") ? "text-emerald-soft" :
                                      log.Accion.Contains("Eliminar") || log.Accion.Contains("Delete") || log.Accion.Contains("Fallido") ? "text-rose-soft" : "text-indigo-soft";
                    
                    <tr>
                        <td class="text-muted small">#@log.Id</td>
                        <td>
                            <strong class="@actionColor small"><i class="fa-solid fa-fingerprint me-1"></i> @log.Accion</strong>
                        </td>
                        <td class="text-white small">@log.Detalle</td>
                        <td class="text-secondary-dark small">@log.IpAddress</td>
                        <td class="text-secondary-dark text-end small">@log.Fecha.ToString("dd/MM/yyyy HH:mm:ss")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <!-- CDN Premium de Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // Cargar datos asíncronamente desde nuestra API JSON en el controlador de reportes
            fetch('/Reportes/GetSalesChartData')
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        inicializarGraficos(data);
                    } else {
                        console.error("Error al cargar datos de gráficos:", data.message);
                    }
                })
                .catch(err => console.error("Error al conectar con la API de reportes:", err));
        });

        function inicializarGraficos(data) {
            // Estilos generales para gráficos oscuros
            Chart.defaults.color = '#94a3b8';
            Chart.defaults.borderColor = 'rgba(255, 255, 255, 0.08)';
            Chart.defaults.font.family = "'Inter', sans-serif";

            // 1. CONFIGURACIÓN DEL GRÁFICO DIARIO (LÍNEA CON GRADIENTE INDIGO GLOW)
            const ctxSales = document.getElementById('salesChart').getContext('2d');
            
            // Crear gradiente de relleno para la línea
            const gradientFill = ctxSales.createLinearGradient(0, 0, 0, 300);
            gradientFill.addColorStop(0, 'rgba(99, 102, 241, 0.4)');
            gradientFill.addColorStop(1, 'rgba(99, 102, 241, 0)');

            new Chart(ctxSales, {
                type: 'line',
                data: {
                    labels: data.labelsDiario,
                    datasets: [{
                        label: 'Ventas Diarias ($)',
                        data: data.datosDiario,
                        borderColor: '#6366f1',
                        borderWidth: 3,
                        pointBackgroundColor: '#818cf8',
                        pointBorderColor: '#090a0f',
                        pointBorderWidth: 2,
                        pointRadius: 5,
                        pointHoverRadius: 7,
                        backgroundColor: gradientFill,
                        fill: true,
                        tension: 0.4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { drawBorder: false },
                            ticks: {
                                callback: function(value) { return '$' + value; }
                            }
                        },
                        x: {
                            grid: { display: false }
                        }
                    }
                }
            });

            // 2. CONFIGURACIÓN DEL GRÁFICO POR CATEGORÍA (DOUGHNUT NEÓN COMPACTO)
            const ctxCategory = document.getElementById('categoryChart').getContext('2d');
            
            new Chart(ctxCategory, {
                type: 'doughnut',
                data: {
                    labels: data.labelsCategoria,
                    datasets: [{
                        data: data.datosCategoria,
                        backgroundColor: [
                            '#6366f1', // Indigo
                            '#10b981', // Emerald
                            '#f59e0b', // Amber
                            '#ef4444', // Rose
                            '#06b6d4', // Cyan
                            '#ec4899'  // Pink
                        ],
                        borderWidth: 2,
                        borderColor: '#0e111a', // Sidebar bg
                        hoverOffset: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                boxWidth: 12,
                                padding: 15,
                                font: { size: 11 }
                            }
                        }
                    },
                    cutout: '65%'
                }
            });
        }
    </script>
}
