@model Producto
@{
    ViewData["Title"] = "Crear Producto";
    var categories = ViewBag.Categorias as List<Categoria> ?? new List<Categoria>();
}

<div class="mb-4">
    <a asp-action="Index" class="btn-premium-outline btn-sm">
        <i class="fa-solid fa-arrow-left"></i> Volver al Listado
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="glass-card card-glow p-5">
            <h2 class="font-outfit fw-bold mb-2"><i class="fa-solid fa-box text-indigo-soft me-2"></i> Registrar Nuevo Producto</h2>
            <p class="text-muted mb-4">Ingresa las características técnicas y comerciales del producto</p>

            <form asp-action="Crear" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" style="font-size: 14px;"></div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Nombre" class="form-label text-secondary-dark small fw-bold">Nombre del Artículo</label>
                        <input asp-for="Nombre" class="form-control" placeholder="Ej: Monitor LED 24'" style="border: 1px solid var(--card-border-dark);" required />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="CategoriaId" class="form-label text-secondary-dark small fw-bold">Categoría Asociada</label>
                        <select asp-for="CategoriaId" class="form-select" style="border: 1px solid var(--card-border-dark);" required>
                            <option value="">Selecciona una Categoría</option>
                            @foreach (var c in categories)
                            {
                                <option value="@c.Id">@c.Nombre</option>
                            }
                        </select>
                        <span asp-validation-for="CategoriaId" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Descripcion" class="form-label text-secondary-dark small fw-bold">Descripción Comercial</label>
                    <textarea asp-for="Descripcion" rows="3" class="form-control" placeholder="Describe brevemente las bondades y especificaciones del producto..." style="border: 1px solid var(--card-border-dark);" required></textarea>
                    <span asp-validation-for="Descripcion" class="text-danger small"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Precio" class="form-label text-secondary-dark small fw-bold">Precio Unitario</label>
                        <input asp-for="Precio" type="number" step="0.01" min="0" class="form-control" placeholder="0.00" style="border: 1px solid var(--card-border-dark);" required />
                        <span asp-validation-for="Precio" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Stock" class="form-label text-secondary-dark small fw-bold">Existencias Iniciales (Stock)</label>
                        <input asp-for="Stock" type="number" min="0" class="form-control" placeholder="0" style="border: 1px solid var(--card-border-dark);" required />
                        <span asp-validation-for="Stock" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="ImagenUrl" class="form-label text-secondary-dark small fw-bold">URL de la Imagen del Producto (Opcional)</label>
                    <input asp-for="ImagenUrl" class="form-control" placeholder="https://ejemplo.com/imagen.jpg" style="border: 1px solid var(--card-border-dark);" />
                    <span asp-validation-for="ImagenUrl" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <div class="form-check form-switch">
                        <input asp-for="Estado" class="form-check-input bg-transparent" type="checkbox" role="switch" checked style="border: 1px solid var(--card-border-dark);" />
                        <label asp-for="Estado" class="form-check-label text-white small fw-bold ms-2">Habilitado / Visible en la Tienda</label>
                    </div>
                </div>

                <button type="submit" class="btn-premium w-100 py-3 justify-content-center">
                    <i class="fa-solid fa-floppy-disk me-2"></i> Registrar Producto
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
