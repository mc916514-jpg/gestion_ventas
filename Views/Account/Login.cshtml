@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar Sesión";
}

<div class="row justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="col-md-5">
        <div class="glass-card card-glow text-center p-5">
            
            <i class="fa-solid fa-user-shield text-indigo-soft bg-indigo-soft rounded-circle p-3 mb-4" style="font-size: 32px;"></i>
            
            <h2 class="mb-2">Ingreso al Sistema</h2>
            <p class="text-muted mb-4">Introduce tus credenciales para acceder a la plataforma</p>

            <form asp-controller="Account" asp-action="Login" method="post" class="text-start">
                <input type="hidden" name="ReturnUrl" value="@ViewBag.ReturnUrl" />
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" style="font-size: 14px;"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label text-secondary-dark small fw-bold">Correo Electrónico</label>
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-end-0 border-secondary-dark text-secondary-dark" style="border: 1px solid var(--card-border-dark);">
                            <i class="fa-solid fa-envelope"></i>
                        </span>
                        <input asp-for="Email" class="form-control border-start-0" placeholder="ejemplo@correo.com" style="border: 1px solid var(--card-border-dark);" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Password" class="form-label text-secondary-dark small fw-bold">Contraseña</label>
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-end-0 border-secondary-dark text-secondary-dark" style="border: 1px solid var(--card-border-dark);">
                            <i class="fa-solid fa-lock"></i>
                        </span>
                        <input asp-for="Password" type="password" class="form-control border-start-0" placeholder="••••••••" style="border: 1px solid var(--card-border-dark);" />
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn-premium w-100 py-3 mb-3 justify-content-center">
                    <i class="fa-solid fa-right-to-bracket me-2"></i> Iniciar Sesión
                </button>
            </form>

            <div class="mt-4 pt-3 border-top" style="border-color: var(--card-border-dark) !important;">
                <p class="text-secondary-dark small mb-0">
                    ¿No tienes una cuenta aún? 
                    <a asp-controller="Account" asp-action="Register" class="text-indigo-soft fw-bold text-decoration-none ms-1">Registrarse</a>
                </p>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
